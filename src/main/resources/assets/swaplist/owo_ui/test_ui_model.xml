                <box>
                    <sizing>
                        <vertical method="fixed">1</vertical>
                        <horizontal method="fill">100</horizontal>
                    </sizing>
                    <color>white</color>

                    <fill>true</fill>
                </box>
                <box>
                    <sizing>
                        <vertical method="fixed">1</vertical>
                        <horizontal method="fill">100</horizontal>
                    </sizing>

                    <fill>true</fill>
                </box>

                <scroll direction="vertical" id="catalogue">
                    <flow-layout direction="vertical" id="catalogue-container">
                        <children/>
                    </flow-layout>
                    <padding>
                        <all>13</all>
                    </padding>

                    <sizing>
                        <vertical method="expand">100</vertical>
                        <horizontal method="fixed">300</horizontal>
                    </sizing>

                    <surface>
                        <vanilla-translucent/>
                    </surface>
                </scroll>

                <box>
                    <sizing>
                        <vertical method="fixed">1</vertical>
                        <horizontal method="fixed">300</horizontal>
                    </sizing>

                    <fill>true</fill>
                </box>
                <box>
                    <sizing>
                        <vertical method="fixed">1</vertical>
                        <horizontal method="fixed">300</horizontal>
                    </sizing>
                    <color>white</color>

                    <fill>true</fill>
                </box>

                <flow-layout direction="vertical" id="footer">
                    <children>
                        <flow-layout direction="horizontal" id="footer-row1">
                            <children>
                                <button id="load">
                                    <renderer>
                                        <flat color="black" hovered-color="dark-gray" disabled-color="red"/>
                                    </renderer>
                                    <text>Load List</text>
                                </button>
                                <button id="rename">
                                    <text>Rename</text>
                                    <active>false</active>
                                </button>
                                <button id="new">
                                    <text>New List</text>
                                </button>
                                <button id="delete">
                                    <text>Delete</text>
                                </button>
                            </children>
                            <gap>10</gap>

                        </flow-layout>
                        <flow-layout direction="horizontal" id="footer-row2">
                            <children>
                                <button id="load">
                                    <text>Templates</text>
                                </button>
                                <button id="save-as">
                                    <text>Save As</text>
                                </button>
                            </children>
                            <gap>10</gap>
                        </flow-layout>
                    </children>

                    <margins>
                        <all>10</all>
                    </margins>
                    <gap>7</gap>
                    <horizontal-alignment>center</horizontal-alignment>

                </flow-layout>

            </children>

            <vertical-alignment>bottom</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>

            <surface>
                <options-background/>
            </surface>
        </flow-layout>
    </components>

    <templates>
        <template name="catalogue-entry">
            <label id="label">
